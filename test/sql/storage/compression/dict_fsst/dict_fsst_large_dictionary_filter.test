# name: test/sql/storage/compression/dict_fsst/dict_fsst_large_dictionary_filter.test
# description: Filters evaluated on the values of DICT_FSST dictionaries larger than a vector
# group: [dict_fsst]

require vector_size 2048

load {TEST_DIR}/dict_fsst_large_dictionary_filter.db readwrite v2.0.0

statement ok
SET force_compression = 'dict_fsst'

statement ok
CREATE TABLE big AS
SELECT CASE WHEN i % 7 = 0 THEN '' WHEN i % 11 = 0 THEN NULL ELSE 'v' || (i % 5000)::VARCHAR END AS s
FROM range(100000) t(i)

statement ok
CHECKPOINT

restart

query I
SELECT count(*) > 0 FROM pragma_storage_info('big')
WHERE column_name = 's'
  AND segment_type = 'VARCHAR'
  AND compression = 'DICT_FSST'
----
true

query I
SELECT count(*) FROM big WHERE s <> ''
----
77922

query I
SELECT count(*) FROM big WHERE strlen(s) > 2
----
77764

query I
SELECT count(*) FROM big WHERE s < 'v2'
----
31618

query I
SELECT count(*) FROM big WHERE s IS NULL
----
7792

query I
SELECT count(*) FROM big WHERE s <> '' AND s < 'v2'
----
17332

# the filter a join pushes into the scan of its probe side
query I
SELECT count(*) FROM big JOIN (SELECT 'v' || (i * 7)::VARCHAR AS s FROM range(400) t(i)) k USING (s)
----
6181
